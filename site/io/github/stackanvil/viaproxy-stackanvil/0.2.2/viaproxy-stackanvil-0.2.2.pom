  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.stackanvil</groupId>
  <artifactId>viaproxy-stackanvil</artifactId>
  <version>0.2.2</version>
  <name>ViaProxy</name>
  <description>Standalone proxy which allows players to join EVERY Minecraft server version (Classic, Alpha, Beta, Release, Bedrock)</description>
  <url>https://github.com/ViaVersion/ViaProxy</url>
  <licenses>
    <license>
      <name>GPL-3.0 License</name>
      <url>https://github.com/ViaVersion/ViaProxy/blob/main/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>RK_01</id>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ViaVersion/ViaProxy.git</connection>
    <developerConnection>scm:git:ssh://github.com/ViaVersion/ViaProxy.git</developerConnection>
    <url>https://github.com/ViaVersion/ViaProxy.git</url>
  </scm>
